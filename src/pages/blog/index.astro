---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import { SITE_DESCRIPTION } from '../../consts';
import Page from '../../layouts/Page.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const byYear = Map.groupBy(posts, (post) => post.data.pubDate.getUTCFullYear());
---

<Page title="Writing" description={SITE_DESCRIPTION}>
	<h1>Writing</h1>
	{
		[...byYear].map(([year, yearPosts]) => (
			<section>
				<h2>{year}</h2>
				<PostList posts={yearPosts} />
			</section>
		))
	}
</Page>
<style>
	h1 {
		margin-bottom: 2rem;
	}
	section + section {
		margin-top: 2.5rem;
	}
	h2 {
		margin: 0 0 0.5rem;
		color: var(--muted);
		font-size: 0.95rem;
		font-weight: 400;
		font-style: italic;
	}
</style>
