---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Page from '../layouts/Page.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 10);
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<p>
			Hi, I'm Thomas. I'm a software engineer, and this is where I write about the things I build,
			break and learn along the way.
		</p>
	</section>

	<section>
		<h2>Recent writing</h2>
		<PostList posts={posts} />
		<p class="all"><a href="/blog">All posts →</a></p>
	</section>
</Page>
<style>
	.intro {
		margin-bottom: 3rem;
	}
	h2 {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 0.95rem;
		font-weight: 400;
		font-style: italic;
	}
	.all {
		margin-top: 1.5rem;
	}
</style>
